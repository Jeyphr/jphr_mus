{
    "gameplay": 
    {
        "global":
        {
            "all_items_cost_multiplier": 1
        },

        "perksacola": 
        {
            "perk_deadshot_headshot_damage_multiplier": 2
        },

        "powerups":
        {
            "max_powerups_per_round": 4,
            "powerup_spawn_frequency_multiplier": 0.25,

            "powerup_max_ammo":
            {
                "enabled": true,
                "chance_to_allow_in_rotation": 0.25,
                "disabled_before_round": 0,
                "fills_magazine": false,
                "toast": "Max Ammo!",
                "show_toast": true,
                "model": "models/pu/maxammo!.mdl",
                "voiceover": "sounds/pu/maxammo.wav"
            },

            "powerup_instakill":
            {
                "enabled": true,
                "chance_to_allow_in_rotation": 1,
                "disabled_before_round": 0,
                "duration": 30,
                "toast": "Insta-Kill!",
                "show_toast": false,
                "model": "models/pu/instakill!.mdl",
                "voiceover": "sounds/pu/insta_kill.wav"
            },

            "powerup_double_points":
            {
                "enabled": true,
                "chance_to_allow_in_rotation": 1,
                "disabled_before_round": 0,
                "duration": 30,
                "score_multiplier": 2,
                "toast": "Double Points!",
                "show_toast": true,
                "model": "models/pu/x2!.mdl",
                "voiceover": "sounds/pu/double_points.wav"
            },  

            "powerup_carpenter":
            {
                "enabled": false
            },

            "powerup_nuke":
            {
                "enabled": true,
                "chance_to_allow_in_rotation": 1,
                "disabled_before_round": 4,
                "score_awarded": 400,
                "toast": "Ka-Boom!",
                "show_toast": true,
                "model": "models/pu/nuke!.mdl",
                "voiceover": "sounds/pu/kaboom.wav",
                "explosion_sfx": "sounds/pu/nuke.wav"
            },

            "powerup_free_perk":
            {
                "enabled": false
            },

            "powerup_bonus_points":
            {
                "enabled": true,
                "chance_to_allow_in_rotation": 1,
                "disabled_before_round": 0,
                "score_awarded": 500,
                "toast": "Blood Money!",
                "show_toast": true,
                "model": "models/pu/points!.mdl",
                "voiceover": ""
            },

            "powerup_weapon_upgrade":
            {
                "enabled": true,
                "chance_to_allow_in_rotation": 0.25,
                "disabled_before_round": 10,
                "awarded_score_if_no_upgrade_received": 0,
                "toast": "Get Packed!",
                "show_toast": true,
                "model": "models/pu/pack!.mdl",
                "voiceover": ""
            }
        },

        "ai":
        {
            "zombie":
            {
                "walk_styles":
                {
                    "can_walk": false,
                    "can_jog": false,
                    "can_sprint": true,
                    "can_super_sprint": true
                }
            }
        }
        
    },

    "interface":
    {
        "perksacola":
        {
            "position_style": "bo3",

            "graphics":
            {
                "quickrevive":  "gfx/hud/jphr/clean/perks/reviveDN",
                "juggernog":    "gfx/hud/jphr/clean/perks/jugDN",
                "speedcola":    "gfx/hud/jphr/clean/perks/speedDN",
                "doubletap":    "gfx/hud/jphr/clean/perks/doubleDN",
                "doubletap_2":  "gfx/hud/jphr/clean/perks/double2DN",
                "staminup":     "gfx/hud/jphr/clean/perks/staminDN",
                "flopper":      "gfx/hud/jphr/clean/perks/flopperDN",
                "deadshot":     "gfx/hud/jphr/clean/perks/deadDN",
                "mulekick":     "gfx/hud/jphr/clean/perks/muleDN"
            }
        },

        "rounds":
        {
            "position_style": "bottom_left",
            "skip_intro": true,
            "use_tally_marks_until_round": 0
        },

        "score":
        {
            "position_style": "right",

            "graphics":
            {
                "score_background_full": "gfx/hud/jphr/clean/score/moneybackRed",
                "score_background_condensed": "gfx/hud/jphr/clean/score/moneyback_condensedRed"
            }
        }
    }
}